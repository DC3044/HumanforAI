# What NOT to upload to Cloud Build. Without this file gcloud generates one
# from .gitignore, which works but is regenerated behind your back; keeping it
# explicit means the build context is reviewable.
#
# Note this is the *upload* filter. .dockerignore still applies afterwards,
# inside the build.

.git
.gitignore

# 200MB+ of local virtualenv the build has no use for: the image builds its
# own with `uv sync` in the builder stage.
.venv

# Local dev database. Never wanted in an image, and it holds real messages.
db.sqlite3

__pycache__/
*.pyc

# Build artifacts, regenerated by collectstatic inside the image.
/static/
/media/

# Local settings overrides and secrets.
.env
humanforai/settings/local.py

# Signing key for the MCP Registry namespace, if it ever lands here by mistake.
*.pem

.DS_Store
Thumbs.db
